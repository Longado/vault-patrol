# --- Gemini: Vertex AI (what the deployment uses; no API key needed) ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_LOCATION=global   # gemini-3.5-flash is served from `global`, not a region
GEMINI_MODEL=gemini-3.5-flash

# --- or Google AI Studio instead of the three above ---
# GEMINI_API_KEY=

# --- GitHub (for cloning private vaults + opening PRs) ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
